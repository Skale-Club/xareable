# ─────────────────────────────────────────────────────────────────────────────
# Apps Performance Dashboard — environment
# Copy to `.env.local` for local dev, or set as Coolify runtime env in production.
# NEVER commit real values. The dashboard is READ-ONLY against Coolify.
# ─────────────────────────────────────────────────────────────────────────────

# ── Coolify REST API (app discovery — the source of truth) ──────────────────
# Base must include the /api/v1 suffix.
#   e.g. https://coolify.skale.club/api/v1  or  http://188.245.112.3:8000/api/v1
COOLIFY_BASE=https://coolify.skale.club/api/v1

# BLOCKER B2: a READ-scoped Coolify API token. Without it the dashboard runs in
# a degraded state (server-health + manual probes still work; app discovery is
# disabled and the UI shows "Coolify token not configured").
# BLOCKER B3: reissue this token after the pending RUNBOOK token rotation.
COOLIFY_TOKEN=

# ── Netdata (server CPU / RAM / disk vs 80GB + per-container) ────────────────
# BLOCKER B1: Netdata must be installed on the host. Keep :19999 private; the
# dashboard queries it server-side only. If unreachable, server-health degrades
# gracefully (panel shows "metrics unavailable") and the rest still works.
NETDATA_BASE=http://127.0.0.1:19999

# The host's hard disk constraint. Disk is a first-class metric; alerts fire as
# usage approaches the prune threshold.
DISK_LIMIT_GB=80
DISK_WARN_PCT=75
DISK_CRIT_PCT=85

# ── Probe / refresh tuning ──────────────────────────────────────────────────
PROBE_TIMEOUT_MS=5000
PROBE_CONCURRENCY=8
# Server-side cache TTL between client polls (avoids hammering the Coolify API).
SNAPSHOT_CACHE_TTL_MS=10000
# Client auto-refresh interval (15–30s recommended).
REFRESH_INTERVAL_MS=20000
# Latency above this (ms) flags an app as "slow".
SLOW_LATENCY_MS=1500

# ── Access control (BLOCKER B4 — decide before exposing real data) ──────────
# Stub gate: HTTP Basic auth via Next middleware. Set as "user:password".
# Leave empty to disable the gate (DEV ONLY — the app logs a warning).
# Production recommendation: front with Cloudflare Access and leave this empty.
DASHBOARD_BASIC_AUTH=

# ── Supabase (DEFERRED — interface is ready; leave empty for in-memory v1) ───
# When set, a Supabase-backed MetricsStore can replace the in-memory ring buffer
# to make history durable across redeploys. Not implemented yet (see src/lib/store).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
