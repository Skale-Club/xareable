# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Application Configuration
APP_URL=https://xareable.com

# Database Configuration
DATABASE_URL=postgresql://user:password@host:port/database

# Server Configuration
PORT=3000
NODE_ENV=development

# Stripe Configuration
# Use sk_test_... in development and sk_live_... in production
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
# Use the endpoint signing secret from Stripe Dashboard or `stripe listen`
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# AI Configuration (Phase 12.3 — DB-managed, no env required)
#
# GEMINI_API_KEY and OPENAI_API_KEY are NO LONGER read from env.
# Both are managed by admin in the app at /admin → Platform API Keys.
# Per-affiliate keys are stored on profiles.api_key / profiles.openai_api_key
# and set by the affiliate at /settings.
#
# Tier model:
#   - Admin    → uses platform_settings.gemini_api_key (shared)
#   - Affiliate→ uses profile.api_key (own)
#   - Regular  → uses platform_settings.gemini_api_key (shared, paid via credits)

# Object Storage — Cloudflare R2 (replaces the Supabase `user_assets` bucket)
#
# All five must be set together; if any is missing the app silently falls back
# to Supabase Storage (useful for local dev and as the rollback path).
# Create the bucket + an "Object Read & Write" API token at:
#   Cloudflare dashboard → R2 → Manage API Tokens
#
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET=xareable-assets
# Public origin the bucket is served from, NO trailing slash.
# Must be the custom domain connected to the bucket, not the r2.dev URL
# (r2.dev is rate-limited and unsupported for production by Cloudflare).
R2_PUBLIC_BASE_URL=https://cdn.xareable.com
